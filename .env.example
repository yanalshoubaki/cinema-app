# TMDB (https://www.themoviedb.org/settings/api) - v3 API key, server-side only
API_KEY=

# TMDB base URL used by server routes in app/api/*
BACKEND_API_URL=https://api.themoviedb.org/3

# Base URL of this app's own API routes, used by the browser (axios client)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
